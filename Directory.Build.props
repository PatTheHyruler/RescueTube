<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <NullableContextOptions>enable</NullableContextOptions>
        <WarningsAsErrors>CS8509,CS8600,CS8601,CS8602,CS8603,CS8604,CS8613,CS8618,CS8619,CS8620,CS8622,CS8625,CS8629,CS8634,CS8714,CS8766,CA2021</WarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
</Project>
